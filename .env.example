# Copy to .env and fill in. Never commit the real .env.

# FalkorDB connection (local Docker or FalkorDB Cloud free tier at
# app.falkordb.cloud/signup). Format: redis://[:password@]host:port
FALKORDB_URL=redis://localhost:6379

# Set to true to use a real FalkorDB server; omit/false uses the in-memory shim.
GRAPHMEM_BACKEND=false

# Google Gemini API key for real LLM replies. Leave unset to use MockLLM.
GEMINI_API_KEY=
